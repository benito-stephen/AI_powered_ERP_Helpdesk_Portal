# Gemini API Key (for chat only — embeddings are generated locally)
GEMINI_API_KEY=AQ.Ab8RN6Je7IlgSHJ9GFVy1N9Nv1aGLwxrNAFNba8ycG1_9XFOrg
GEMINI_MODEL=gemini-2.5-flash

# Local SentenceTransformer embedding model (runs on CPU, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistent vector database
CHROMA_PATH=./chromadb
CHROMA_COLLECTION=erp_documents

# MySQL – RAG database (separate from erp_portal)
RAG_DB_HOST=localhost
RAG_DB_PORT=3307
RAG_DB_NAME=erp_rag
RAG_DB_USER=root
RAG_DB_PASSWORD=

# Upload storage directory (relative to fastapi_rag/)
UPLOADS_DIR=./uploads

# Chunking parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval parameters
TOP_K_CHUNKS=5
SIMILARITY_THRESHOLD=0.35

# Max upload file size in MB
MAX_FILE_SIZE_MB=20
