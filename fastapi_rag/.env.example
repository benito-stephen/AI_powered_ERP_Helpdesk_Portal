# ============================================================
#  FastAPI RAG Service – Environment Configuration
#  Copy this file to .env and fill in your values.
# ============================================================

# Gemini API Key (same key used in config.php)
GEMINI_API_KEY=AIzaSyAQ.Ab8RN6Je7IlgSHJ9GFVy1N9Nv1aGLwxrNAFNba8ycG1_9XFOrg
GEMINI_MODEL=gemini-2.5-flash

# MySQL – RAG database (separate from erp_portal)
RAG_DB_HOST=localhost
RAG_DB_PORT=3307
RAG_DB_NAME=erp_rag
RAG_DB_USER=root
RAG_DB_PASSWORD=

# ChromaDB persistent storage path (relative to fastapi_rag/)
CHROMA_PATH=./chromadb
CHROMA_COLLECTION=erp_documents

# Embedding model (local SentenceTransformer)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Upload storage directory (relative to fastapi_rag/)
UPLOADS_DIR=./uploads

# Chunking parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval parameters
TOP_K_CHUNKS=5
SIMILARITY_THRESHOLD=0.3

# Max upload file size in MB
MAX_FILE_SIZE_MB=20
